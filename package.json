  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "chemx": "^26.10.29-360",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
